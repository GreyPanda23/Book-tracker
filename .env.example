# Copy this file to ".env" (same folder) and fill in what you use.
# ".env" stays on your computer - it is never uploaded to GitHub.

# --- Sync with the phone app (needed for the GitHub/phone setup) ---
GITHUB_TOKEN=
GITHUB_REPO=GreyPanda23/Book-tracker
# GITHUB_DATA_BRANCH=data

# --- Book search (optional; without it Open Library is used) ---
GOOGLE_BOOKS_API_KEY=

# --- AI recommendations (optional) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Price-drop e-mails (optional) ---
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# EMAIL_TO=

# --- Password for the app (recommended for the online/phone version) ---
APP_PASSWORD=
